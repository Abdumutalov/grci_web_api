# ===== Auth =====
# Секрет подписи access-токенов (HS256). ДОЛЖЕН совпадать с оригиналом, иначе
# токены, выданные старым сервером, станут невалидными.
JWT_SECRET=change-me

# ===== Server =====
SERVER_PORT=3000
# NODE_ENV=production включает флаг Secure у cookie refresh_token/csrf —
# задавайте только если фронтенд работает по HTTPS (оригинал NODE_ENV не задавал).
# NODE_ENV=production
# true — учитывать X-Forwarded-For в req.ip (в оригинале выключено)
TRUST_PROXY=false
# Каталог со сборкой SPA (по умолчанию ./build)
STATIC_DIR=./build
# Swagger UI: http://host:port/api-docs
SWAGGER_ENABLED=true
SWAGGER_PATH=api-docs

# ===== Protocol (файловый журнал) =====
PROTOCOL_PATH=./log/
PROTOCOL_WRITE=true

# ===== Oracle client =====
# Оригинал всегда работал в Thick-режиме (oracledb.initOracleClient()).
ORACLE_THICK_MODE=true
# Каталог Oracle Instant Client (если не в PATH)
ORACLE_CLIENT_LIB_DIR=
# Каталог с tnsnames.ora (если не задан TNS_ADMIN)
ORACLE_TNS_ADMIN=

# ===== Main DB (ГРКИ) =====
DB_USER=site
DB_PASSWORD=change-me
DB_CONNECT_STRING=GRCI
DB_POOL_ALIAS=real
DB_POOL_MIN=1
DB_POOL_MAX=100
DB_POOL_INCREMENT=1
DB_POOL_TIMEOUT=15

# ===== IABS DB (odbank) =====
IABS_USER=odbank
IABS_PASSWORD=change-me
IABS_CONNECT_STRING=IABSDB
IABS_POOL_ALIAS=odbank
IABS_POOL_MIN=1
IABS_POOL_MAX=100
IABS_POOL_INCREMENT=1
IABS_POOL_TIMEOUT=15

# ===== ЭЦП (SOAP CBRU TCrypt) =====
CRYPTO_URL=http://cripto/tcas/CBRUTcryptAS.asmx?wsdl
